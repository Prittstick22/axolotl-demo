# Axolotl demo build - the .env for the demo laptop. demo/start.ps1 and demo/start.sh
# copy this to the repository root as .env when there isn't one. See demo/DEMO_BUILD.md.
# Never put the team cluster's URI here: the demo runs on this laptop's own MongoDB.

# --- the laptop's own MongoDB (Atlas Local in Docker; the start script starts it) ---
MONGODB_URI=mongodb://localhost:27017/?directConnection=true
MONGODB_DATABASE=axolotl

# --- replay: Argon's answers come from this recorded live run, not from Gemini ---
# Relative to backend/. The delay paces each replayed turn: 0.5 gives about a
# 1.5-2 minute migration; use 1-2 for a slower video.
ARGON_REPLAY_FILE=../demo/replays/run_c86aff1bea77.json
ARGON_REPLAY_DELAY_SECONDS=0.5

# --- Gemini: optional ---
# Empty means no Gemini calls at all, and searches use keyword matching (labelled).
# With a key, searches use hybrid matching, at one small embedding call per search.
# Keep the embedding model and dimensions as they are: the seeded search index was
# built with them. Argon is replayed either way.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-4-argon
GEMINI_DESCRIPTION_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
INDEX_ON_IMPORT=false

# --- sandbox and servers ---
RUNNER_MODE=trusted_docker
RUNNER_IMAGE=axolotl-runner:latest
WORKSPACE_ROOT=./.axolotl_workspaces
FRONTEND_ORIGIN=http://localhost:5173
